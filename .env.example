# ironclaw-ai environment configuration

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/ironclaw

# Redis connection string
REDIS_URL=redis://localhost:6379

# Service URL (internal HTTP base for workers)
IRONCLAW_SERVICE_URL=http://localhost:3000

# HTTP port
PORT=3000

# Node environment
NODE_ENV=development

# Telegram (required by the idle reminder worker — posts directly to Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gemini — powers the daily coaching worker (07:00 / 13:00 / 23:00).
# Falls back to a static motivational message if unset/unavailable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Timezone — drives habit schedule windows AND the coaching slot times.
TZ=Asia/Jakarta
