# ironclaw-ai environment configuration

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/ironclaw

# Redis connection string
REDIS_URL=redis://localhost:6379

# Service URL (internal HTTP base for workers)
IRONCLAW_SERVICE_URL=http://localhost:3000

# HTTP port
PORT=3000

# Node environment
NODE_ENV=development

# Telegram (required by the idle reminder worker — posts directly to Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gemini — powers the daily coaching worker (07:00 / 13:00 / 23:00).
# Falls back to a static motivational message if unset/unavailable.
GEMINI_API_KEY=
# Strong model for the daily coaching brief.
GEMINI_MODEL=gemini-2.5-pro
# Faster/cheaper model for short messages (completion cheers, recovery nudges).
GEMINI_FAST_MODEL=gemini-2.5-flash
# Per-attempt timeout (ms) and number of retries on transient failures.
GEMINI_TIMEOUT_MS=60000
GEMINI_RETRIES=2

# Timezone — drives habit schedule windows AND the coaching slot times.
TZ=Asia/Jakarta

# Google OAuth — from the OAuth Client JSON in Google Cloud Console.
# Set the real values in .env locally and in Railway variables (never commit).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-app.up.railway.app/auth/google/callback
