# ironclaw-ai environment configuration

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/ironclaw

# Redis connection string
REDIS_URL=redis://localhost:6379

# Service URL (used in SKILL.md automations)
IRONCLAW_SERVICE_URL=http://localhost:3000

# HTTP port
PORT=3000

# Node environment
NODE_ENV=development

# Telegram (required by the idle reminder worker — posts directly to Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Timezone for habit schedule windows (e.g. Asia/Jakarta)
TZ=Asia/Jakarta
