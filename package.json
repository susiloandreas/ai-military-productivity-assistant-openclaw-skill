{
  "name": "ironclaw-ai",
  "version": "1.0.0",
  "description": "Military Discipline & Performance Operating System for OpenClaw",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && cp -r src/db/migrations dist/db/",
    "dev": "ts-node --esm src/server.ts",
    "start": "node dist/server.js",
    "start:idle-reminder": "node dist/schedulers/IdleReminderWorker.js",
    "dev:idle-reminder": "ts-node src/schedulers/IdleReminderWorker.ts",
    "migrate": "ts-node --esm src/utils/migrate.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "bullmq": "^5.0.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "ioredis": "^5.0.0",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.10.0",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
